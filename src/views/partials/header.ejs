<header class="header">
  <nav class="navbar">
    <div class="container">
      <!-- Logo Section -->
      <a href="<%= typeof t !== 'undefined' ? t.urls.home : '/' %>" class="logo">
        <img src="/images/logo/logo-dark.png" alt="Bosowa Bandar Group" class="logo-light">
        <img src="/images/logo/logo-signin.png" alt="Bosowa Bandar Group" class="logo-dark" style="display:none;">
      </a>

      <!-- Navigation Menu (Desktop & Mobile Sidebar) -->
      <ul class="nav-menu" id="navMenu">
        <!-- Mobile Sidebar Header -->
        <li class="nav-sidebar-header">
          <a href="<%= typeof t !== 'undefined' ? t.urls.home : '/' %>" class="sidebar-logo">
            <img src="/images/logo/logo-dark.png" alt="Bosowa Bandar Group" class="sidebar-logo-light">
            <img src="/images/logo/logo-signin.png" alt="Bosowa Bandar Group" class="sidebar-logo-dark">
          </a>
          <button class="nav-close" id="navClose" aria-label="Close menu">
            <i class="fas fa-times"></i>
          </button>
        </li>
        <li class="nav-sidebar-divider"></li>
        <li><a href="<%= typeof t !== 'undefined' ? t.urls.home : '/' %>" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.home : 'Beranda' %></a></li>
        <li><a href="<%= typeof t !== 'undefined' ? t.urls.about : '/about' %>" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.about : 'Tentang Kami' %></a></li>
        <li><a href="<%= typeof t !== 'undefined' ? t.urls.visionMission : '/visi-misi' %>" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.visionMission : 'Visi Misi' %></a></li>
        <li class="nav-dropdown">
          <a href="#" class="nav-link dropdown-toggle"><%= typeof t !== 'undefined' ? t.nav.businessUnits : 'Unit Bisnis' %> <i class="fas fa-chevron-down nav-arrow"></i></a>
          <ul class="nav-dropdown-menu">
            <li><a href="<%= typeof t !== 'undefined' ? t.businessUnitUrls.bosowabandarindonesia : '/unit-bisnis/bosowa-bandar-indonesia' %>" class="nav-link">PT Bosowa Bandar Indonesia</a></li>
            <li><a href="<%= typeof t !== 'undefined' ? t.businessUnitUrls.bosowabandaragensi : '/unit-bisnis/bosowa-bandar-agensi' %>" class="nav-link">PT Bosowa Bandar Agensi</a></li>
            <li><a href="<%= typeof t !== 'undefined' ? t.businessUnitUrls.jasapelabuhanindonesia : '/unit-bisnis/jasa-pelabuhan-indonesia' %>" class="nav-link">PT Jasa Pelabuhan Indonesia</a></li>
          </ul>
        </li>
        <li><a href="<%= typeof t !== 'undefined' ? t.urls.branches : '/cabang' %>" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.branches : 'Info Cabang' %></a></li>
        <li><a href="<%= typeof t !== 'undefined' ? t.urls.news : '/berita' %>" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.news : 'Berita' %></a></li>
        <li><a href="#footer" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.contact : 'Kontak' %></a></li>
        <% if (user) { %>
          <li><a href="/admin" class="nav-link"><%= typeof t !== 'undefined' ? t.nav.admin : 'Admin' %></a></li>
        <% } %>

        <!-- Mobile Actions (Visible only on mobile sidebar) -->
        <li class="nav-mobile-actions">
            <!-- Mobile Language Switcher -->
            <% if (typeof lang !== 'undefined') { %>
            <div class="mobile-lang-group">
              <span class="mobile-action-label"><%= typeof t !== 'undefined' ? (t.lang === 'id' ? 'Bahasa' : 'Language') : 'Bahasa' %></span>
              <div class="mobile-lang-switcher">
                <a href="/id<%= typeof currentPath !== 'undefined' ? currentPath : '' %>" 
                   class="mobile-lang-btn <%= lang === 'id' ? 'active' : '' %>">
                   <img src="/images/flags/id.svg" alt="ID"> Indonesia
                </a>
                <a href="<%= typeof getAltLangUrl === 'function' && lang === 'id' ? getAltLangUrl() : '/en' + (typeof currentPath !== 'undefined' ? currentPath : '') %>" 
                   class="mobile-lang-btn <%= lang === 'en' ? 'active' : '' %>">
                   <img src="/images/flags/en.svg" alt="EN"> English
                </a>
              </div>
            </div>
            <% } %>

            <!-- Mobile Signin -->
            <div class="mobile-auth-group">
            <% if (user) { %>
              <a href="/admin/logout" class="mobile-btn-auth btn-signout">
                <i class="fas fa-sign-out-alt"></i>
                <span><%= typeof t !== 'undefined' ? t.nav.logout : 'Keluar' %></span>
              </a>
            <% } else { %>
              <a href="/admin/login" class="mobile-btn-auth">
                <i class="fas fa-sign-in-alt"></i>
                <span><%= typeof t !== 'undefined' ? t.nav.login : 'Masuk' %></span>
              </a>
            <% } %>
            </div>
        </li>
      </ul>

      <!-- Right Section: Language Switcher, Theme Toggle & Signin -->
      <div class="nav-actions">
        <!-- Language Switcher -->
        <% if (typeof lang !== 'undefined') { %>
        <div class="lang-switcher">
          <a href="/id<%= typeof currentPath !== 'undefined' ? currentPath : '' %>" 
             class="lang-btn <%= lang === 'id' ? 'active' : '' %>" 
             title="Bahasa Indonesia">
            <img src="/images/flags/id.svg" alt="ID" class="flag-icon">
          </a>
          <a href="<%= typeof getAltLangUrl === 'function' && lang === 'id' ? getAltLangUrl() : '/en' + (typeof currentPath !== 'undefined' ? currentPath : '') %>" 
             class="lang-btn <%= lang === 'en' ? 'active' : '' %>" 
             title="English">
            <img src="/images/flags/en.svg" alt="EN" class="flag-icon">
          </a>
        </div>
        <% } %>
        
        <% if (user) { %>
          <a href="/admin/logout" class="btn-signin btn-signout">
            <i class="fas fa-sign-out-alt"></i>
            <span><%= typeof t !== 'undefined' ? t.nav.logout : 'Keluar' %></span>
          </a>
        <% } else { %>
          <a href="/admin/login" class="btn-signin">
            <i class="fas fa-sign-in-alt"></i>
            <span><%= typeof t !== 'undefined' ? t.nav.login : 'Masuk' %></span>
          </a>
        <% } %>
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
          <i class="fas fa-sun"></i>
          <i class="fas fa-moon"></i>
        </button>
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div class="nav-overlay" id="navOverlay"></div>
</header>
