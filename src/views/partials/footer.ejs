<footer id="footer" class="footer">
  <div class="container">
    <div class="footer-top">
      <!-- Left Column: Logo & Description -->
      <!-- Left Column: Logo & Description -->
      <div class="footer-brand">
        <a href="<%= typeof t !== 'undefined' ? t.urls.home : '/' %>" class="footer-logo">
          <img src="/images/logo/logo-dark.webp" alt="Bosowa Bandar Group" class="footer-logo-light">
          <img src="/images/logo/logo-signin.webp" alt="Bosowa Bandar Group" class="footer-logo-dark" style="display:none;">
        </a>
        <p class="footer-desc">
          <%= typeof t !== 'undefined' && t.lang === 'en' ? 'A national private company established bringing the local history of Eastern Indonesia. Bosowa Bandar Indonesia is a Port Business Entity (BUP) which is part of Bosowa Corporindo. We provide port management services, ship agency, cargo handling (PBM) and tugboat services.' : 'Perusahaan swasta nasional berdiri membawa sejarah lokal Indonesia Timur. Bosowa Bandar Indonesia merupakan Badan Usaha Pelabuhan (BUP) yang merupakan bagian dari Bosowa Corporindo. Kami memberikan pelayanan pengelolaan pelabuhan, keagenan kapal, jasa bongkar muat (PBM) dan layanan kapal tunda.' %>
        </p>
      </div>

      <!-- Middle Column: Contact Info -->
      <div class="footer-contact">
        <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Contact Us' : 'Hubungi Kami' %></h3>
        <ul class="contact-list">
          <li class="contact-address">
            <strong><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Address:' : 'Alamat:' %></strong> <%= settings.company_address || 'Menara Bosowa Lt. 8 Unit J Jl. Jend. Sudirman No.5 Kel. Pisang Utara, Kec. Ujung Pandang Kota Makassar, Sulawesi Selatan Indonesia 90115' %>
          </li>
          <li>
            <strong>Email:</strong> <a href="mailto:<%= settings.company_email || 'bosowa.bandar@bosowa.co.id' %>"><%= settings.company_email || 'bosowa.bandar@bosowa.co.id' %></a>
          </li>
          <li>
            <strong>WhatsApp:</strong> <a href="https://wa.me/<%= settings.company_whatsapp || '628988821777' %>" target="_blank">+<%= settings.company_whatsapp || '628988821777' %></a>
          </li>
          <li>
            <strong>Website:</strong> <a href="<%= settings.company_website || 'https://bosowabandar.com/' %>" target="_blank" rel="noopener noreferrer"><%= settings.company_website || 'https://bosowabandar.com/' %></a>
          </li>
        </ul>
        <div class="footer-social">
          <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Social Media' : 'Sosial Media' %></h3>
          <div class="social-links">
            <a href="https://www.instagram.com/bosowabandarindonesia/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <i class="fab fa-instagram"></i>
            </a>
            <a href="https://youtube.com/@bosowabandarindonesia?si=1LbAtQYfa1minsb8" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <i class="fab fa-youtube"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Location Map -->
      <div class="footer-location">
        <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Our Location' : 'Lokasi Kami' %></h3>
        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3973.8071451177057!2d119.41418780000001!3d-5.1347348!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dbf030020151c7f%3A0x91f6cbbf1acbc877!2sPT.%20Bosowa%20Bandar%20Indonesia!5e0!3m2!1sid!2sid!4v1762738404067!5m2!1sid!2sid"
            width="100%"
            height="200"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
          <div class="map-overlay-info">
            <strong>PT. Bosowa Bandar Indonesia</strong>
            <a href="https://maps.google.com/?q=PT.+Bosowa+Bandar+Indonesia" target="_blank"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'View larger map' : 'Lihat peta lebih besar' %></a>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="footer-copyright">
    <div class="container">
      <div class="copyright-content">
        <p>&copy; <%= new Date().getFullYear() %> Bosowa Bandar Indonesia. <%= typeof t !== 'undefined' && t.lang === 'en' ? 'All rights reserved.' : 'Hak cipta dilindungi.' %></p>
      </div>
    </div>
  </div>
</footer>
