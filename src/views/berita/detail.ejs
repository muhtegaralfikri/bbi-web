<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= berita.title %> - Bosowa Bandar Group</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <meta name="description" content="<%= berita.content.substring(0, 160) %>">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <%
      // Get language-specific content
      const isEn = typeof t !== 'undefined' && t.lang === 'en';
      const displayTitle = isEn && berita.title_en ? berita.title_en : berita.title;
      const displayContent = isEn && berita.content_en ? berita.content_en : berita.content;
    %>
    <article class="article-detail">
      <div class="container">
        <% if (berita.image) { %>
          <img src="<%= berita.image %>" alt="<%= displayTitle %>" class="article-image">
        <% } %>
        <div class="article-content">

          <h1><%= displayTitle %></h1>
          <div class="article-meta">
            <span><i class="far fa-calendar"></i> <%= new Date(berita.created_at).toLocaleDateString(typeof t !== 'undefined' && t.lang === 'en' ? 'en-US' : 'id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
          <div class="article-body">
            <%- displayContent %>
          </div>
          <div class="article-footer">
            <a href="<%= typeof t !== 'undefined' ? t.urls.news : '/berita' %>" class="btn btn-outline">&larr; <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Back to News' : 'Kembali ke Berita' %></a>
          </div>
        </div>

        <!-- Comments Section -->
        <div class="comments-section">
          <div class="comments-header">
            <h3><i class="fas fa-comments"></i> <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Comments' : 'Komentar' %> (<%= commentPagination ? commentPagination.total : (comments ? comments.length : 0) %>)</h3>
          </div>

          <!-- Comment List -->
          <div class="comments-list">
            <% if (comments && comments.length > 0) { %>
              <% comments.forEach(c => { %>
                <div class="comment-item">
                  <div class="comment-avatar">
                    <i class="fas fa-user-circle"></i>
                  </div>
                  <div class="comment-content">
                    <div class="comment-meta">
                      <strong><%= c.name %></strong>
                      <span><%= new Date(c.created_at).toLocaleDateString(typeof t !== 'undefined' && t.lang === 'en' ? 'en-US' : 'id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                    </div>
                    <p><%= c.content %></p>
                  </div>
                </div>
              <% }); %>
              
              <% if (commentPagination && commentPagination.totalPages > 1) { %>
                <div class="pagination" style="margin-top: 1.5rem;">
                  <% if (commentPagination.page > 1) { %>
                    <a href="?comment_page=<%= commentPagination.page - 1 %>" class="btn btn-outline btn-arrow"><i class="fas fa-chevron-left"></i></a>
                  <% } else { %>
                    <span class="btn btn-outline btn-arrow" style="opacity: 0.5; cursor: not-allowed;"><i class="fas fa-chevron-left"></i></span>
                  <% } %>
                  
                  <% for (let i = 1; i <= commentPagination.totalPages; i++) { %>
                    <a href="?comment_page=<%= i %>" class="btn <%= i === commentPagination.page ? 'btn-primary' : 'btn-outline' %>"><%= i %></a>
                  <% } %>
                  
                  <% if (commentPagination.page < commentPagination.totalPages) { %>
                    <a href="?comment_page=<%= commentPagination.page + 1 %>" class="btn btn-outline btn-arrow"><i class="fas fa-chevron-right"></i></a>
                  <% } else { %>
                    <span class="btn btn-outline btn-arrow" style="opacity: 0.5; cursor: not-allowed;"><i class="fas fa-chevron-right"></i></span>
                  <% } %>
                </div>
              <% } %>
            <% } else { %>
              <p class="no-comments"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'No comments yet. Be the first to comment!' : 'Belum ada komentar. Jadilah yang pertama berkomentar!' %></p>
            <% } %>
          </div>

          <!-- Comment Form -->
          <div class="comment-form-wrapper">
            <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Leave a Comment' : 'Tinggalkan Komentar' %></h3>
            <p class="text-muted"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Your email address will not be published.' : 'Alamat email Anda tidak akan dipublikasikan.' %></p>
            
            <div id="comment-alert" style="display: none;" class="alert alert-success">
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Comment submitted successfully and awaiting admin moderation.' : 'Komentar berhasil dikirim dan menunggu moderasi admin.' %>
            </div>

            <form action="<%= typeof t !== 'undefined' ? t.urls.news : '/berita' %>/<%= berita.id %>/comment" method="POST" class="comment-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="name"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Name' : 'Nama' %> *</label>
                  <input type="text" id="name" name="name" required placeholder="<%= typeof t !== 'undefined' && t.lang === 'en' ? 'Full Name' : 'Nama Lengkap' %>">
                </div>
                <div class="form-group">
                  <label for="email">Email *</label>
                  <input type="email" id="email" name="email" required placeholder="<%= typeof t !== 'undefined' && t.lang === 'en' ? 'Your Email' : 'Email Anda' %>">
                </div>
              </div>
              <div class="form-group">
                <label for="content"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Comment' : 'Komentar' %> *</label>
                <textarea id="content" name="content" rows="4" required placeholder="<%= typeof t !== 'undefined' && t.lang === 'en' ? 'Write your comment here...' : 'Tulis komentar Anda di sini...' %>"></textarea>
              </div>
              <button type="submit" class="btn btn-primary"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Submit Comment' : 'Kirim Komentar' %></button>
            </form>
          </div>
        </div>

        <script>
          // Check for success param
          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.get('comment_submitted') === 'true') {
            document.getElementById('comment-alert').style.display = 'block';
            // Clean URL
            window.history.replaceState({}, document.title, window.location.pathname);
          }
        </script>
      </div>
    </article>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
