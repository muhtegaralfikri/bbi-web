<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof t !== 'undefined' ? t.news.title : 'Berita & Artikel' %> - Bosowa Bandar Group</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css?v=2.2">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <h1><%= typeof t !== 'undefined' ? t.news.title : 'Berita' %></h1>
        <p class="page-subtitle"><%= typeof t !== 'undefined' ? t.news.subtitle : 'Ikuti perkembangan terbaru dari Bosowa Bandar Group melalui berita dan informasi terkini seputar aktivitas perusahaan.' %></p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="grid grid-1">
          <% if (berita && berita.length > 0) { %>
            <% berita.forEach(item => { 
              // Get language-specific content
              const isEn = typeof t !== 'undefined' && t.lang === 'en';
              const displayTitle = isEn && item.title_en ? item.title_en : item.title;
              const displaySummary = isEn && item.summary_en ? item.summary_en : (item.summary || item.content.replace(/<[^>]*>?/gm, '').substring(0, 120));
            %>
              <article class="card card-news">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= displayTitle %>" class="card-image">
                <% } %>
                <div class="card-content">

                  <h3><%= displayTitle %></h3>
                  <p class="card-excerpt"><%= displaySummary %>...</p>
                  <div class="card-meta">
                    <span><i class="far fa-calendar"></i> <%= new Date(item.created_at).toLocaleDateString(typeof t !== 'undefined' && t.lang === 'en' ? 'en-US' : 'id-ID') %></span>
                  </div>
                  <a href="<%= typeof t !== 'undefined' ? t.urls.news : '/berita' %>/<%= item.slug %>" class="btn-link"><%= typeof t !== 'undefined' ? t.home.readMore : 'Baca Selengkapnya' %></a>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="text-align: center; padding: 3rem;">
              <h3>Belum ada berita</h3>
            </div>
          <% } %>
        </div>

        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="pagination">
            <% if (pagination.page > 1) { %>
              <a href="?page=<%= pagination.page - 1 %>" class="btn btn-outline btn-arrow"><i class="fas fa-chevron-left"></i></a>
            <% } else { %>
              <span class="btn btn-outline btn-arrow" style="opacity: 0.5; cursor: not-allowed;"><i class="fas fa-chevron-left"></i></span>
            <% } %>
            
            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
              <a href="?page=<%= i %>" class="btn <%= i === pagination.page ? 'btn-primary' : 'btn-outline' %>"><%= i %></a>
            <% } %>
            
            <% if (pagination.page < pagination.totalPages) { %>
              <a href="?page=<%= pagination.page + 1 %>" class="btn btn-outline btn-arrow"><i class="fas fa-chevron-right"></i></a>
            <% } else { %>
              <span class="btn btn-outline btn-arrow" style="opacity: 0.5; cursor: not-allowed;"><i class="fas fa-chevron-right"></i></span>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
