<% layout = false %>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Bosowa Bandar Group</title>
  <meta name="description" content="<%= description %>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="section unit-bisnis-detail">
      <div class="container">
        <div class="ub-layout">
          <!-- Main Content -->
          <div class="ub-main">
            <h1 class="ub-title">PT Bosowa Bandar Agensi</h1>
            <p class="ub-subtitle">
              PT Bosowa Bandar Agensi adalah unit kapal bisnis yang bergerak di bidang keagenan, 
              memberikan layanan profesional dan efisien untuk mendukung kelancaran aktivitas 
              pelayaran di pelabuhan Bosowa dan sekitarnya.
            </p>

            <div class="ub-content">
              <p>
                Sebagai bagian dari Bosowa Group, Bosowa kapal Bandar Agensi berperan dalam memfasilitasi 
                operasional domestik maupun internasional yang berlabuh di wilayah kerja Bosowa. 
                Kami memastikan pelayanan keagenan berjalan cepat, aman, dan sesuai regulasi.
              </p>
            </div>
          </div>

          <!-- Sidebar -->
          <aside class="ub-sidebar">
            <div class="ub-sidebar-card">
              <h3>Daerah Jangkauan</h3>
              
              <div class="ub-area-grid">
                <div class="ub-area">
                  <h4>Daerah Sulawesi Selatan</h4>
                  <ul>
                    <li>Makassar</li>
                    <li>Jeneponto</li>
                    <li>Baru</li>
                  </ul>
                </div>

                <div class="ub-area">
                  <h4>Wilayah Luar Sulawesi Selatan</h4>
                  <ul>
                    <li>Palu</li>
                    <li>Konawe</li>
                    <li>Kendari</li>
                    <li>Banyuwangi</li>
                    <li>Probolinggo</li>
                    <li>Samarinda</li>
                  </ul>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
