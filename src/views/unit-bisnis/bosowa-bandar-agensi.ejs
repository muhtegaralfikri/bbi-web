<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Bosowa Bandar Group</title>
  <meta name="description" content="<%= description %>">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css?v=2.4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="section unit-bisnis-detail">
      <div class="container">
        <div class="ub-layout">
          <!-- Main Content -->
          <div class="ub-main">
            <h1 class="ub-title">PT Bosowa Bandar Agensi</h1>
            <p class="ub-subtitle">
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'PT Bosowa Bandar Agensi is a ship agency business unit that provides professional and efficient services to support smooth shipping activities at Bosowa ports and surrounding areas.' : 'PT Bosowa Bandar Agensi adalah unit bisnis keagenan kapal yang memberikan layanan profesional dan efisien untuk mendukung kelancaran aktivitas pelayaran di pelabuhan Bosowa dan sekitarnya.' %>
            </p>

            <div class="ub-content">
              <p>
                <%= typeof t !== 'undefined' && t.lang === 'en' ? 'As part of Bosowa Group, Bosowa Bandar Agensi plays a role in facilitating domestic and international ship operations docking in Bosowa\'s working area. We ensure agency services run quickly, safely, and in compliance with regulations.' : 'Sebagai bagian dari Bosowa Group, Bosowa Bandar Agensi berperan dalam memfasilitasi operasional kapal domestik maupun internasional yang berlabuh di wilayah kerja Bosowa. Kami memastikan pelayanan keagenan berjalan cepat, aman, dan sesuai regulasi.' %>
              </p>
            </div>
          </div>

          <!-- Sidebar -->
          <aside class="ub-sidebar">
            <div class="ub-sidebar-card">
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Coverage Area' : 'Daerah Jangkauan' %></h3>
              
              <div class="ub-area-grid">
                <div class="ub-area">
                  <h4><%= typeof t !== 'undefined' && t.lang === 'en' ? 'South Sulawesi Region' : 'Daerah Sulawesi Selatan' %></h4>
                  <ul>
                    <li>Makassar</li>
                    <li>Jeneponto</li>
                    <li>Barru</li>
                  </ul>
                </div>

                <div class="ub-area">
                  <h4><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Outside South Sulawesi' : 'Wilayah Luar Sulawesi Selatan' %></h4>
                  <ul>
                    <li>Palu</li>
                    <li>Konawe</li>
                    <li>Kendari</li>
                    <li>Banyuwangi</li>
                    <li>Probolinggo</li>
                    <li>Samarinda</li>
                  </ul>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
