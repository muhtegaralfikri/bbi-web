<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Bosowa Bandar Group</title>
  <meta name="description" content="<%= description %>">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css?v=2.4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="section unit-bisnis-detail">
      <div class="container">
        <div class="ub-layout">
          <!-- Main Content -->
          <div class="ub-main">
            <h1 class="ub-title">PT Bosowa Bandar Indonesia</h1>
            <p class="ub-subtitle">
              <%- typeof t !== 'undefined' && t.lang === 'en' ? 'PT Bosowa Bandar Indonesia (BBI) is part of <strong>Bosowa Group</strong> which operates in port management, cargo handling, and integrated logistics services.' : 'PT Bosowa Bandar Indonesia (BBI) merupakan bagian dari <strong>Bosowa Group</strong> yang bergerak di bidang pengelolaan pelabuhan, bongkar muat, dan layanan logistik terpadu.' %>
            </p>

            <div class="ub-content">
              <p>
                <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Bosowa Bandar Indonesia is here to improve port operational efficiency through modern management systems and complete supporting infrastructure. We are committed to providing sustainable logistics solutions for the national maritime industry.' : 'Bosowa Bandar Indonesia hadir untuk meningkatkan efisiensi operasional pelabuhan melalui sistem manajemen modern dan infrastruktur pendukung yang lengkap. Kami berkomitmen menghadirkan solusi logistik berkelanjutan untuk industri maritim nasional.' %>
              </p>
            </div>
          </div>

          <!-- Sidebar -->
          <aside class="ub-sidebar">
            <div class="ub-sidebar-card">
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Main Service Area' : 'Area Layanan Utama' %></h3>
              
              <div class="ub-area">
                <h4><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Jeneponto Area' : 'Area Jeneponto' %></h4>
                <ul>
                  <li>PLTU Bosowa Energi</li>
                  <li>PLN Punagaya</li>
                </ul>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
