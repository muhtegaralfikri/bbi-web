<% layout = false %>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Bosowa Bandar Group</title>
  <meta name="description" content="<%= description %>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header" style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white;">
      <div class="container">
        <h1 style="color: white;">PT Bosowa Bandar Indonesia</h1>
        <p style="font-size: 1.1rem; margin-top: 1rem; opacity: 0.9;">Leading Port Services Provider in Indonesia</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div style="max-width: 900px; margin: 0 auto;">
          <div class="card" style="padding: 2rem; box-shadow: none; border: 1px solid var(--border);">
            <div style="text-align: center; margin-bottom: 2rem;">
              <i class="fas fa-ship" style="font-size: 4rem; color: var(--primary);"></i>
            </div>

            <h2 style="color: var(--text); margin-bottom: 1.5rem; text-align: center;">Tentang Perusahaan</h2>
            <p style="color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
              PT Bosowa Bandar Indonesia adalah perusahaan jasa kepelabuhanan yang berdedikasi untuk memberikan layanan terbaik
              dalam pengelolaan dan operasional pelabuhan. Dengan pengalaman bertahun-tahun, kami telah menjadi mitra
              terpercaya dalam mendukung aktivitas perdagangan maritim di Indonesia.
            </p>

            <h3 style="color: var(--text); margin-bottom: 1rem; margin-top: 2rem;">Layanan Kami</h3>
            <div class="grid grid-2" style="gap: 1.5rem; margin-bottom: 2rem;">
              <div style="padding: 1.5rem; background: var(--bg-secondary); border-radius: 0.5rem;">
                <i class="fas fa-anchor" style="font-size: 2rem; color: var(--primary); margin-bottom: 1rem;"></i>
                <h4 style="margin-bottom: 0.5rem;">Jasa Bongkar Muat</h4>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">Layanan loading dan unloading dengan peralatan modern dan tenaga ahli berpengalaman.</p>
              </div>
              <div style="padding: 1.5rem; background: var(--bg-secondary); border-radius: 0.5rem;">
                <i class="fas fa-warehouse" style="font-size: 2rem; color: var(--primary); margin-bottom: 1rem;"></i>
                <h4 style="margin-bottom: 0.5rem;">Penyimpanan Barang</h4>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">Fasilitas gudang aman dan luas untuk penyimpanan jangka pendek maupun panjang.</p>
              </div>
              <div style="padding: 1.5rem; background: var(--bg-secondary); border-radius: 0.5rem;">
                <i class="fas fa-truck-loading" style="font-size: 2rem; color: var(--primary); margin-bottom: 1rem;"></i>
                <h4 style="margin-bottom: 0.5rem;">Handling Cargo</h4>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">Penanganan kargo dengan standar keamanan tinggi dan efisiensi optimal.</p>
              </div>
              <div style="padding: 1.5rem; background: var(--bg-secondary); border-radius: 0.5rem;">
                <i class="fas fa-clipboard-check" style="font-size: 2rem; color: var(--primary); margin-bottom: 1rem;"></i>
                <h4 style="margin-bottom: 0.5rem;">Dokumentasi</h4>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">Layanan administrasi dan dokumentasi kepabeanan yang terintegrasi.</p>
              </div>
            </div>

            <h3 style="color: var(--text); margin-bottom: 1rem; margin-top: 2rem;">Visi & Misi</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
              <div>
                <h4 style="color: var(--primary); margin-bottom: 0.75rem;"><i class="fas fa-eye"></i> Visi</h4>
                <p style="color: var(--text-secondary); line-height: 1.8;">
                  Menjadi perusahaan jasa kepelabuhanan terdepan yang memberikan pelayanan prima dan berorientasi pada
                  kepuasan pelanggan.
                </p>
              </div>
              <div>
                <h4 style="color: var(--primary); margin-bottom: 0.75rem;"><i class="fas fa-bullseye"></i> Misi</h4>
                <ul style="color: var(--text-secondary); line-height: 1.8; padding-left: 1.25rem;">
                  <li>Memberikan pelayanan kepelabuhanan yang efisien dan profesional</li>
                  <li>Mengembangkan kapasitas dan kualitas fasilitas secara berkelanjutan</li>
                  <li>Meningkatkan kompetensi SDM melalui pelatihan berkelanjutan</li>
                  <li>Membangun kemitraan strategis dengan stakeholder</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
