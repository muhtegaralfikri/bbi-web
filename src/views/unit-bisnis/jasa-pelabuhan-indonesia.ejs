<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Bosowa Bandar Group</title>
  <meta name="description" content="<%= description %>">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css?v=2.4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="section unit-bisnis-detail">
      <div class="container">
        <div class="ub-layout">
          <!-- Main Content -->
          <div class="ub-main">
            <h1 class="ub-title">PT Jasa Pelabuhan Indonesia</h1>
            <p class="ub-subtitle">
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'PT Jasa Pelabuhan Indonesia is a business entity focused on port operational management and providing technical support services for cargo handling, terminal, and maritime operations.' : 'PT Jasa Pelabuhan Indonesia merupakan entitas bisnis yang fokus pada pengelolaan operasional pelabuhan dan menyediakan layanan teknis pendukung kegiatan bongkar muat, terminal, dan operasional maritim.' %>
            </p>

            <div class="ub-content">
              <p>
                <%= typeof t !== 'undefined' && t.lang === 'en' ? 'With experience and professional resources, Jasa Pelabuhan Indonesia smoothly carries out export-import activities, goods storage, to efficient port infrastructure management.' : 'Dengan pengalaman dan sumber daya profesional, Jasa Pelabuhan Indonesia lancar menjalankan kegiatan ekspor-impor, penyimpanan barang, hingga pengelolaan infrastruktur pelabuhan yang efisien.' %>
              </p>
            </div>
          </div>

          <!-- Sidebar -->
          <aside class="ub-sidebar">
            <div class="ub-sidebar-card">
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Operational Area' : 'Area Operasional' %></h3>
              
              <div class="ub-area-grid">
                <div class="ub-area">
                  <h4><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Banyuwangi Area' : 'Daerah Banyuwangi' %></h4>
                  <ul>
                    <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Semen Bosowa Banyuwangi Dock' : 'Dermaga Semen Bosowa Banyuwangi' %></li>
                    <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Misi Mulia Pertronusa Dock' : 'Dermaga Misi Mulia Pertronusa' %></li>
                  </ul>
                </div>

                <div class="ub-area">
                  <h4><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Jeneponto Area' : 'Daerah Jeneponto' %></h4>
                  <ul>
                    <li>Jetty PLTU Bosowa Energi</li>
                  </ul>
                </div>
              </div>

              <div class="ub-area" style="margin-top: 1.5rem;">
                <h4><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Makassar Area' : 'Daerah Makassar' %></h4>
                <ul>
                  <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'BDE Lantebung Dock' : 'Dermaga BDE Lantebung' %></li>
                  <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Soekarno Hatta Port' : 'Pelabuhan Soekarno Hatta' %></li>
                </ul>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
