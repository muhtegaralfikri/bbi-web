<% layout = false %>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bosowa Bandar Group - Home</title>
  <meta name="description" content="Bosowa Bandar Group - Company Profile">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <% if (contactSuccess) { %>
    <div class="alert-banner alert-success">
      <div class="container">
        <i class="fas fa-check-circle"></i>
        <span>Pesan Anda telah terkirim. Terima kasih!</span>
        <button onclick="this.parentElement.parentElement.remove()" class="alert-close">&times;</button>
      </div>
    </div>
  <% } %>

  <main>
    <!-- Hero Carousel Section -->
    <section class="hero-carousel">
      <div class="carousel-container">
        <!-- Slide 1 -->
        <div class="carousel-slide active" data-slide="0">
          <img src="/images/hero/slide1.jpg" alt="Temukan Layanan Terbaik Untuk Armada Anda" class="slide-bg">
          <div class="slide-overlay"></div>
          <div class="container">
            <div class="hero-content">
              <h1 class="slide-title">Temukan Layanan Terbaik Untuk Armada Anda</h1>
              <p class="slide-subtitle">Bosowa Bandar Group adalah Badan Usaha Pelabuhan (BUP) yang memberikan layanan pengelolaan pelabuhan, keagenan kapal, jasa bongkar muat dan layanan kapal tunda.</p>
              <div class="slide-buttons">
                <a href="https://system.bosowabandar.com/auth/login" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-primary">
                  Bosowa Bandar System
                </a>
                <a href="https://wa.me/628988821777" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-secondary">
                  Hubungi Kami
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-slide" data-slide="1">
          <img src="/images/hero/slide2.jpg" alt="Pelayanan Bongkar Muat Cepat, Aman, dan Profesional" class="slide-bg">
          <div class="slide-overlay"></div>
          <div class="container">
            <div class="hero-content">
              <h1 class="slide-title">Pelayanan Bongkar Muat Cepat, Aman, dan Profesional</h1>
              <p class="slide-subtitle">Didukung oleh tenaga kerja berpengalaman dan peralatan modern, Bosowa Bandar Group memastikan proses bongkar muat berjalan efisien dan tepat waktu untuk setiap kapal yang berlabuh.</p>
              <div class="slide-buttons">
                <a href="https://system.bosowabandar.com/auth/login" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-primary">
                  Bosowa Bandar System
                </a>
                <a href="https://wa.me/628988821777" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-secondary">
                  Hubungi Kami
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-slide" data-slide="2">
          <img src="/images/hero/slide3.jpg" alt="Solusi Terpadu untuk Keagenan dan Tunda Kapal" class="slide-bg">
          <div class="slide-overlay"></div>
          <div class="container">
            <div class="hero-content">
              <h1 class="slide-title">Solusi Terpadu untuk Keagenan dan Tunda Kapal</h1>
              <p class="slide-subtitle">Sebagai mitra strategis industri maritim, kami menyediakan layanan keagenan dan kapal tunda dengan standar keselamatan tinggi, mendukung kelancaran operasional pelabuhan di seluruh wilayah kerja Bosowa.</p>
              <div class="slide-buttons">
                <a href="https://system.bosowabandar.com/auth/login" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-primary">
                  Bosowa Bandar System
                </a>
                <a href="https://wa.me/628988821777" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-secondary">
                  Hubungi Kami
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Arrows -->
        <button class="carousel-nav carousel-prev" id="carouselPrev">
          <i class="fas fa-chevron-left"></i>
        </button>
        <button class="carousel-nav carousel-next" id="carouselNext">
          <i class="fas fa-chevron-right"></i>
        </button>

        <!-- Dots Indicator -->
        <div class="carousel-dots" id="carouselDots">
          <button class="carousel-dot active" data-slide="0"></button>
          <button class="carousel-dot" data-slide="1"></button>
          <button class="carousel-dot" data-slide="2"></button>
        </div>
      </div>
    </section>

    <!-- Unit Bisnis Section -->
    <section class="section unit-bisnis-section">
      <div class="container">
        <!-- Services Grid (Replicated Design) -->
        <div class="section-header text-center mb-5">
          <h2 class="section-title">Unit Bisnis</h2>
          <p class="section-desc">Melalui berbagai unit bisnis, Bosowa Bandar terus memperkuat perannya sebagai penggerak utama sektor logistik dan pelabuhan di kawasan timur Indonesia.</p>
        </div>
        <div class="grid grid-3 services-grid">
          <!-- Item 1: Keagenan Kapal -->
          <div class="service-card">
            <div class="service-icon">
              <!-- Ship Icon -->
              <i class="fas fa-ship"></i>
            </div>
            <h3>Keagenan Kapal</h3>
            <p>Menyediakan layanan agensi perkapalan terbaik untuk kebutuhan reguler maupun sistem pelayaran bebas. Kami telah melayani dibeberapa pelabuhan di Indonesia, diantaranya Pelabuhan Makassar, Jeneponto, Barru, Konawe dan Banyuwangi.</p>
          </div>

          <!-- Item 2: PBM -->
          <div class="service-card">
            <div class="service-icon">
              <i class="fas fa-dolly-flatbed"></i>
            </div>
            <h3>Jasa Bongkar Muat (PBM)</h3>
            <p>Melayani kegiatan pembongkaran barang dari kapal ke dermaga dan pemuatan barang dari dermaga ke kapal.</p>
          </div>

          <!-- Item 3: Tug Assist -->
          <div class="service-card">
            <div class="service-icon">
               <i class="fas fa-anchor"></i>
            </div>
            <h3>Layanan Kapal Tunda</h3>
            <p>Layanan kapal tunda (tug assist) untuk membantu kapal lain, baik dalam mendorong, menarik, maupun menggandeng kapal, khususnya saat akan merapat atau meninggalkan dermaga di pelabuhan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Section -->
    <section class="section video-section">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title">Bosowa Bandar Group</h2>
          <p class="section-desc">
            Perusahaan swasta nasional berdiri membawa sejarah lokal Indonesia Timur. Bosowa Bandar Group merupakan Badan Usaha Pelabuhan (BUP) yang merupakan bagian dari Bosowa Corporindo.
          </p>
        </div>
        <div class="video-wrapper" id="videoWrapper" data-video-id="z4hiz113Ej0">
          <div class="video-thumbnail">
            <img src="/images/video/image.png" alt="Video Thumbnail" class="video-cover">
            <button class="play-btn" aria-label="Play Video">
              <i class="fas fa-play"></i>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- FunFact Section -->
    <section class="section funfact-section">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title">Terpercaya Sejak 2012</h2>
          <p class="section-desc">
            Kami telah memberikan pelayanan terpercaya selama 13 tahun di Indonesia
          </p>
        </div>
        <div class="funfact-grid">
          <!-- Item 1 -->
          <div class="funfact-item">
            <h3 class="funfact-title">Kapal</h3>
            <p class="funfact-value">10.000+</p>
          </div>
          <!-- Item 2 -->
          <div class="funfact-item">
            <h3 class="funfact-title">Cabang</h3>
            <p class="funfact-value">9 Branch</p>
          </div>
          <!-- Item 3 -->
          <div class="funfact-item">
            <h3 class="funfact-title">Mitra</h3>
            <p class="funfact-value">100+</p>
          </div>
        </div>
      </div>
    </section>

      </div>
    </section>

    <!-- Mitra Section -->
    <section class="section mitra-section">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title">Mitra dan Klien</h2>
          <p class="section-desc">
            Bosowa Bandar Group menjalin kemitraan strategis dengan berbagai perusahaan dan lembaga untuk mendukung layanan pelabuhan yang profesional, efisien, dan terpercaya.
          </p>
        </div>
        <div class="mitra-wrapper">
          <div class="mitra-grid">
            <div class="mitra-item">
              <img src="/images/mitra/tiga-roda-semen.webp.png" alt="Semen Tiga Roda">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/hasnur.png" alt="Hasnur International Shipping">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/pelayaran-manalagi.png" alt="Pelayaran Manalagi">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/pertamina.png" alt="Pertamina Trans Kontinental">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/usaha-gas.png" alt="Usaha Gas Elpindo">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Berita Terbaru -->
    <section class="section bg-light">
      <div class="container">
        <h2 class="section-title">Berita Terbaru</h2>
        <div class="grid grid-3">
          <% if (berita && berita.length > 0) { %>
            <% berita.forEach(item => { %>
              <article class="card card-news">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.title %>" class="card-image">
                <% } %>
                <div class="card-content">

                  <h3><%= item.title %></h3>
                  <p class="card-excerpt"><%= item.summary || item.content.replace(/<[^>]*>?/gm, '').substring(0, 120) %>...</p>
                  <div class="card-meta">
                    <span><i class="far fa-calendar"></i> <%= new Date(item.created_at).toLocaleDateString('id-ID') %></span>
                  </div>
                  <a href="/berita/<%= item.slug %>" class="btn-link">Baca Selengkapnya</a>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <p>Belum ada berita.</p>
          <% } %>
        </div>
        <div class="text-center mt-4">
          <a href="/berita" class="btn btn-outline">Lihat Semua Berita</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
