<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof t !== 'undefined' ? t.home.title : 'Bosowa Bandar Group - Home' %></title>
  <meta name="description" content="Bosowa Bandar Group - Company Profile">
  <link rel="stylesheet" href="/css/style.css?v=2.3">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="icon" href="/favicon.png" type="image/png">
</head>
<body>
  <%- include('partials/header') %>

  <% if (contactSuccess) { %>
    <div class="alert-banner alert-success">
      <div class="container">
        <i class="fas fa-check-circle"></i>
        <span><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Your message has been sent. Thank you!' : 'Pesan Anda telah terkirim. Terima kasih!' %></span>
        <button onclick="this.parentElement.parentElement.remove()" class="alert-close">&times;</button>
      </div>
    </div>
  <% } %>

  <main>
    <!-- Hero Carousel Section -->
    <section class="hero-carousel">
      <div class="carousel-container">
        <!-- Slide 1 -->
        <div class="carousel-slide active" data-slide="0">
          <img src="/images/hero/slide1.webp" alt="<%= typeof t !== 'undefined' ? t.home.heroTitle1 : 'Temukan Layanan Terbaik Untuk Armada Anda' %>" class="slide-bg">
          <div class="slide-overlay"></div>
          <div class="container">
            <div class="hero-content">
              <h1 class="slide-title"><%= typeof t !== 'undefined' ? t.home.heroTitle1 : 'Temukan Layanan Terbaik Untuk Armada Anda' %></h1>
              <p class="slide-subtitle"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Bosowa Bandar Group is a Port Business Entity (BUP) that provides port management services, ship agency, cargo handling and tugboat services.' : 'Bosowa Bandar Group adalah Badan Usaha Pelabuhan (BUP) yang memberikan layanan pengelolaan pelabuhan, keagenan kapal, jasa bongkar muat dan layanan kapal tunda.' %></p>
              <div class="slide-buttons">
                <a href="https://system.bosowabandar.com/auth/login" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-primary">
                  Bosowa Bandar System
                </a>
                <a href="https://wa.me/628988821777" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-secondary">
                  <%= typeof t !== 'undefined' ? t.home.contactUs : 'Hubungi Kami' %>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-slide" data-slide="1">
          <img src="/images/hero/slide2.webp" alt="<%= typeof t !== 'undefined' ? t.home.heroTitle2 : 'Pelayanan Bongkar Muat Cepat, Aman, dan Profesional' %>" class="slide-bg">
          <div class="slide-overlay"></div>
          <div class="container">
            <div class="hero-content">
              <h1 class="slide-title"><%= typeof t !== 'undefined' ? t.home.heroTitle2 : 'Pelayanan Bongkar Muat Cepat, Aman, dan Profesional' %></h1>
              <p class="slide-subtitle"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Supported by experienced workforce and modern equipment, Bosowa Bandar Group ensures efficient and timely cargo handling for every docked vessel.' : 'Didukung oleh tenaga kerja berpengalaman dan peralatan modern, Bosowa Bandar Group memastikan proses bongkar muat berjalan efisien dan tepat waktu untuk setiap kapal yang berlabuh.' %></p>
              <div class="slide-buttons">
                <a href="https://system.bosowabandar.com/auth/login" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-primary">
                  Bosowa Bandar System
                </a>
                <a href="https://wa.me/628988821777" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-secondary">
                  <%= typeof t !== 'undefined' ? t.home.contactUs : 'Hubungi Kami' %>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-slide" data-slide="2">
          <img src="/images/hero/slide3.webp" alt="<%= typeof t !== 'undefined' ? t.home.heroTitle3 : 'Solusi Terpadu untuk Keagenan dan Tunda Kapal' %>" class="slide-bg">
          <div class="slide-overlay"></div>
          <div class="container">
            <div class="hero-content">
              <h1 class="slide-title"><%= typeof t !== 'undefined' ? t.home.heroTitle3 : 'Solusi Terpadu untuk Keagenan dan Tunda Kapal' %></h1>
              <p class="slide-subtitle"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'As a strategic partner in the maritime industry, we provide agency and tugboat services with high safety standards, supporting smooth port operations throughout Bosowa\'s working areas.' : 'Sebagai mitra strategis industri maritim, kami menyediakan layanan keagenan dan kapal tunda dengan standar keselamatan tinggi, mendukung kelancaran operasional pelabuhan di seluruh wilayah kerja Bosowa.' %></p>
              <div class="slide-buttons">
                <a href="https://system.bosowabandar.com/auth/login" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-primary">
                  Bosowa Bandar System
                </a>
                <a href="https://wa.me/628988821777" target="_blank" rel="noopener noreferrer" class="btn-slide btn-slide-secondary">
                  <%= typeof t !== 'undefined' ? t.home.contactUs : 'Hubungi Kami' %>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Arrows -->
        <button class="carousel-nav carousel-prev" id="carouselPrev">
          <i class="fas fa-chevron-left"></i>
        </button>
        <button class="carousel-nav carousel-next" id="carouselNext">
          <i class="fas fa-chevron-right"></i>
        </button>

        <!-- Dots Indicator -->
        <div class="carousel-dots" id="carouselDots">
          <button class="carousel-dot active" data-slide="0"></button>
          <button class="carousel-dot" data-slide="1"></button>
          <button class="carousel-dot" data-slide="2"></button>
        </div>
      </div>
    </section>

    <!-- Unit Bisnis Section -->
    <section class="section unit-bisnis-section">
      <div class="container">
        <!-- Services Grid (Replicated Design) -->
        <div class="section-header text-center mb-5">
          <h2 class="section-title"><%= typeof t !== 'undefined' ? t.home.businessUnitsTitle : 'Unit Bisnis' %></h2>
          <p class="section-desc"><%= typeof t !== 'undefined' ? t.home.businessUnitsDesc : 'Melalui berbagai unit bisnis, Bosowa Bandar terus memperkuat perannya sebagai penggerak utama sektor logistik dan pelabuhan di kawasan timur Indonesia.' %></p>
        </div>
        <div class="grid grid-3 services-grid">
          <!-- Item 1: Keagenan Kapal -->
          <div class="service-card">
            <div class="service-icon">
              <!-- Ship Icon -->
              <i class="fas fa-ship"></i>
            </div>
            <h3><%= typeof t !== 'undefined' ? t.services.shipAgency : 'Keagenan Kapal' %></h3>
            <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Providing the best shipping agency services for regular and free sailing system needs. We have served at several ports in Indonesia, including Makassar, Jeneponto, Barru, Konawe and Banyuwangi ports.' : 'Menyediakan layanan agensi perkapalan terbaik untuk kebutuhan reguler maupun sistem pelayaran bebas. Kami telah melayani dibeberapa pelabuhan di Indonesia, diantaranya Pelabuhan Makassar, Jeneponto, Barru, Konawe dan Banyuwangi.' %></p>
          </div>

          <!-- Item 2: PBM -->
          <div class="service-card">
            <div class="service-icon">
              <i class="fas fa-dolly-flatbed"></i>
            </div>
            <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Cargo Handling (PBM)' : 'Jasa Bongkar Muat (PBM)' %></h3>
            <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Serving the unloading of goods from ships to the dock and loading of goods from the dock to ships.' : 'Melayani kegiatan pembongkaran barang dari kapal ke dermaga dan pemuatan barang dari dermaga ke kapal.' %></p>
          </div>

          <!-- Item 3: Tug Assist -->
          <div class="service-card">
            <div class="service-icon">
               <i class="fas fa-anchor"></i>
            </div>
            <h3><%= typeof t !== 'undefined' ? t.services.tugBoat : 'Layanan Kapal Tunda' %></h3>
            <p><%= typeof t !== 'undefined' ? t.services.tugBoatDesc : 'Layanan kapal tunda (tug assist) untuk membantu kapal lain, baik dalam mendorong, menarik, maupun menggandeng kapal, khususnya saat akan merapat atau meninggalkan dermaga di pelabuhan.' %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Section -->
    <style>
      .video-section {
        position: relative;
        overflow: hidden;
        padding: 5rem 0;
        background: linear-gradient(to bottom, var(--bg-secondary) 0%, var(--bg) 100%);
      }
      .video-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: radial-gradient(var(--primary) 1px, transparent 1px);
        background-size: 30px 30px;
        opacity: 0.03;
        pointer-events: none;
      }
      .video-wrapper {
        position: relative;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
        height: 0;
        background: black;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.3);
        transform: translateZ(0);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .video-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 1.5rem;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.2);
        pointer-events: none;
        z-index: 10;
      }
      .video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      @media (max-width: 768px) {
        .video-wrapper {
          border-radius: 1rem;
          width: 100% !important; 
          box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.3);
        }
        .video-wrapper::after {
          border-radius: 1rem;
        }
        .video-section {
          padding: 3rem 0;
        }
      }
    </style>
    <section class="section video-section">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title">Bosowa Bandar Group</h2>
          <p class="section-desc">
            <%= typeof t !== 'undefined' && t.lang === 'en' ? 'A national private company established bringing the local history of Eastern Indonesia. Bosowa Bandar Group is a Port Business Entity (BUP) which is part of Bosowa Corporindo.' : 'Perusahaan swasta nasional berdiri membawa sejarah lokal Indonesia Timur. Bosowa Bandar Group merupakan Badan Usaha Pelabuhan (BUP) yang merupakan bagian dari Bosowa Corporindo.' %>
          </p>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/z4hiz113Ej0?si=FbxLQzqAYAWduwqo" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <!-- FunFact Section -->
    <section class="section funfact-section">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title"><%= typeof t !== 'undefined' ? t.home.trustedSince : 'Terpercaya Sejak 2012' %></h2>
          <p class="section-desc">
            <%= typeof t !== 'undefined' && t.lang === 'en' ? 'We have provided trusted services for 13 years in Indonesia' : 'Kami telah memberikan pelayanan terpercaya selama 13 tahun di Indonesia' %>
          </p>
        </div>
        <div class="funfact-grid">
          <!-- Item 1 -->
          <div class="funfact-item">
            <h3 class="funfact-title"><%= typeof t !== 'undefined' ? t.home.ships : 'Kapal' %></h3>
            <p class="funfact-value">10.000+</p>
          </div>
          <!-- Item 2 -->
          <div class="funfact-item">
            <h3 class="funfact-title"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Branches' : 'Cabang' %></h3>
            <p class="funfact-value">9 <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Branches' : 'Cabang' %></p>
          </div>
          <!-- Item 3 -->
          <div class="funfact-item">
            <h3 class="funfact-title"><%= typeof t !== 'undefined' ? t.home.partners : 'Mitra' %></h3>
            <p class="funfact-value">100+</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mitra Section -->
    <section class="section mitra-section">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Partners and Clients' : 'Mitra dan Klien' %></h2>
          <p class="section-desc">
            <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Bosowa Bandar Group establishes strategic partnerships with various companies and institutions to support professional, efficient, and trusted port services.' : 'Bosowa Bandar Group menjalin kemitraan strategis dengan berbagai perusahaan dan lembaga untuk mendukung layanan pelabuhan yang profesional, efisien, dan terpercaya.' %>
          </p>
        </div>
        <div class="mitra-wrapper">
          <div class="mitra-grid">
            <div class="mitra-item">
              <img src="/images/mitra/tiga-roda-semen.webp" alt="Semen Tiga Roda">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/hasnur.webp" alt="Hasnur International Shipping">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/pelayaran-manalagi.webp" alt="Pelayaran Manalagi">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/pertamina.webp" alt="Pertamina Trans Kontinental">
            </div>
            <div class="mitra-item">
              <img src="/images/mitra/usaha-gas.webp" alt="Usaha Gas Elpindo">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Berita Terbaru -->
    <section class="section bg-light">
      <div class="container">
        <h2 class="section-title"><%= typeof t !== 'undefined' ? t.home.latestNews : 'Berita Terbaru' %></h2>
        <div class="grid grid-3">
          <% if (berita && berita.length > 0) { %>
            <% berita.forEach(item => { 
              // Get language-specific content
              const isEn = typeof t !== 'undefined' && t.lang === 'en';
              const displayTitle = isEn && item.title_en ? item.title_en : item.title;
              const displaySummary = isEn && item.summary_en ? item.summary_en : (item.summary || item.content.replace(/<[^>]*>?/gm, '').substring(0, 120));
            %>
              <article class="card card-news">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= displayTitle %>" class="card-image">
                <% } %>
                <div class="card-content">

                  <h3><%= displayTitle %></h3>
                  <p class="card-excerpt"><%= displaySummary %>...</p>
                  <div class="card-meta">
                    <span><i class="far fa-calendar"></i> <%= new Date(item.created_at).toLocaleDateString(typeof t !== 'undefined' && t.lang === 'en' ? 'en-US' : 'id-ID') %></span>
                  </div>
                  <a href="<%= typeof t !== 'undefined' ? t.urls.news : '/berita' %>/<%= item.slug %>" class="btn-link"><%= typeof t !== 'undefined' ? t.home.readMore : 'Baca Selengkapnya' %></a>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="text-align: center; padding: 3rem;">
              <h3>Belum ada berita</h3>
            </div>
          <% } %>
        </div>
        <div class="text-center mt-4">
          <a href="<%= typeof t !== 'undefined' ? t.urls.news : '/berita' %>" class="btn btn-outline"><%= typeof t !== 'undefined' ? t.home.viewAllNews : 'Lihat Semua Berita' %></a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
