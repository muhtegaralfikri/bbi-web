<%- include('../partials/admin-head', { pageTitle: 'Kelola Cabang' }) %>
<%- include('../../partials/header') %>
<%- include('../partials/admin-nav', { active: 'cabang' }) %>

<main class="admin-layout">
  <div class="container">
    <header class="admin-header">
      <h1>Kelola Cabang</h1>
      <a href="/admin/cabang/create" class="btn btn-primary"><i class="fas fa-plus"></i> Tambah Cabang</a>
    </header>

    <div class="admin-body">
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Nama</th>
              <th>Alamat</th>
              <th>Telepon</th>
              <th>Email</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% cabang.forEach(c => { %>
              <tr>
                <td><%= c.name %></td>
                <td><%= c.address || '-' %></td>
                <td><%= c.phone || '-' %></td>
                <td><%= c.email || '-' %></td>
                <td>
                  <a href="/admin/cabang/<%= c.id %>/edit" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                  <form action="/admin/cabang/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Hapus cabang ini?')" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
<%- include('../partials/admin-foot') %>
