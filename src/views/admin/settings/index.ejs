<%- include('../partials/admin-head', { pageTitle: 'Pengaturan' }) %>
<%- include('../../partials/header') %>
<%- include('../partials/admin-nav', { active: 'settings' }) %>

<main class="admin-layout">
  <div class="container">
    <header class="admin-header">
      <h1>Pengaturan</h1>
    </header>

    <div class="admin-body">
      <form action="/admin/settings" method="POST" class="form" enctype="multipart/form-data">
        <h2>Informasi Perusahaan</h2>
        <div class="form-group">
          <label for="company_name">Nama Perusahaan</label>
          <input type="text" id="company_name" name="company_name" value="<%= settings.company_name || '' %>">
        </div>

        <div class="form-group">
          <label for="company_desc">Deskripsi Singkat</label>
          <textarea id="company_desc" name="company_desc" rows="4"><%= settings.company_desc || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="company_address">Alamat</label>
          <textarea id="company_address" name="company_address" rows="3"><%= settings.company_address || '' %></textarea>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label for="company_phone">Telepon</label>
              <input type="text" id="company_phone" name="company_phone" value="<%= settings.company_phone || '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label for="company_whatsapp">WhatsApp (Format: 628...)</label>
              <input type="text" id="company_whatsapp" name="company_whatsapp" value="<%= settings.company_whatsapp || '' %>">
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label for="company_email">Email</label>
              <input type="email" id="company_email" name="company_email" value="<%= settings.company_email || '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label for="company_website">Website URL</label>
              <input type="url" id="company_website" name="company_website" value="<%= settings.company_website || '' %>">
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="company_maps">Google Maps Embed URL (src only)</label>
          <input type="text" id="company_maps" name="company_maps" value="<%= settings.company_maps || '' %>">
          <small class="form-text text-muted">Copy URL dari atribut src iframe Google Maps.</small>
        </div>

        <div class="form-group">
          <label for="company_maps_link">Link Google Maps (View Larger Map)</label>
          <input type="url" id="company_maps_link" name="company_maps_link" value="<%= settings.company_maps_link || '' %>">
        </div>

        <h2>Sosial Media</h2>
        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label for="social_instagram">Instagram</label>
              <input type="url" id="social_instagram" name="social_instagram" value="<%= settings.social_instagram || '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label for="social_youtube">YouTube</label>
              <input type="url" id="social_youtube" name="social_youtube" value="<%= settings.social_youtube || '' %>">
            </div>
          </div>
        </div>

        <h2>Video Perusahaan</h2>
        <div class="form-group">
          <label for="video_file">Upload Video (MP4, WebM, OGG - Max 500MB)</label>
          <input type="file" id="video_file" name="video_file" accept="video/mp4,video/webm,video/ogg">
          <% if (settings.video_file) { %>
            <div style="margin-top: 0.5rem;">
              <small class="text-muted">Video saat ini: <a href="<%= settings.video_file %>" target="_blank"><%= settings.video_file %></a></small>
            </div>
            <video src="<%= settings.video_file %>" style="max-width: 200px; margin-top: 0.5rem;" controls></video>
          <% } %>
        </div>

        <div class="form-group">
          <label for="video_thumbnail">Upload Thumbnail Video (JPG, PNG, WebP)</label>
          <input type="file" id="video_thumbnail" name="video_thumbnail" accept="image/jpeg,image/png,image/webp">
          <% if (settings.video_thumbnail) { %>
            <div style="margin-top: 0.5rem;">
              <small class="text-muted">Thumbnail saat ini: <a href="<%= settings.video_thumbnail %>" target="_blank"><%= settings.video_thumbnail %></a></small>
            </div>
            <img src="<%= settings.video_thumbnail %>" style="max-width: 200px; margin-top: 0.5rem;" alt="Video Thumbnail">
          <% } %>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="delete_video" value="1">
            Hapus video dan thumbnail
          </label>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan Pengaturan</button>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
<%- include('../partials/admin-foot') %>
