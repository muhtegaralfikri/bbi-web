<%- include('partials/admin-head', { pageTitle: 'Admin Panel' }) %>
<%- include('../partials/header') %>

<main class="admin-layout">
  <div class="container">
    <!-- Admin Header -->
    <header class="admin-header">
      <h1>Admin Panel</h1>
      <div class="admin-user">
        <%= user.name %>
      </div>
    </header>

    <!-- Admin Tabs -->
    <div class="admin-tabs">
      <button class="admin-tab <%= activeTab === 'berita' ? 'active' : '' %>" data-tab="berita">
        <i class="fas fa-newspaper"></i> Berita
      </button>
      <button class="admin-tab <%= activeTab === 'cabang' ? 'active' : '' %>" data-tab="cabang">
        <i class="fas fa-building"></i> Cabang
      </button>
      <button class="admin-tab <%= activeTab === 'comments' ? 'active' : '' %>" data-tab="comments">
        <i class="fas fa-comments"></i> Komentar
      </button>
      <button class="admin-tab <%= activeTab === 'settings' ? 'active' : '' %>" data-tab="settings">
        <i class="fas fa-cog"></i> Pengaturan
      </button>
    </div>

    <!-- Tab Content -->
    <div class="admin-body">
      
      <!-- ========== BERITA TAB ========== -->
      <div class="tab-content <%= activeTab === 'berita' ? 'active' : '' %>" id="tab-berita">
        <div class="tab-header">
          <h2><i class="fas fa-newspaper" style="color: var(--admin-primary); margin-right: 0.5rem;"></i> Manajemen Berita</h2>
          <button class="btn btn-primary" onclick="toggleForm('berita')">
            <i class="fas fa-plus"></i> Tambah Berita
          </button>
        </div>
        
        <!-- Form Tambah/Edit Berita -->
        <div class="form-section <%= (editType === 'berita') ? 'form-visible' : '' %>" id="form-berita">
          <form action="<%= editData && editType === 'berita' ? '/admin/berita/' + editData.id + '/update' : '/admin/berita/create' %>" method="POST" class="inline-form" enctype="multipart/form-data">
            <h3><%= editData && editType === 'berita' ? 'Edit Berita' : 'Tambah Berita Baru' %></h3>
            
            <!-- Language Tabs -->
            <div class="lang-tabs" style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
              <button type="button" class="lang-tab active" data-lang="id" onclick="switchLangTab('id')">
                🇮🇩 Indonesia
              </button>
              <button type="button" class="lang-tab" data-lang="en" onclick="switchLangTab('en')">
                🇬🇧 English
              </button>
            </div>
            
            <!-- Indonesian Content -->
            <div class="lang-content active" id="lang-content-id">
              <div class="form-group">
                <label for="berita_title">Judul Berita (ID) <span style="color: red;">*</span></label>
                <input type="text" id="berita_title" name="title" value="<%= editData && editType === 'berita' ? editData.title : '' %>" required placeholder="Masukkan judul berita dalam Bahasa Indonesia">
              </div>
              
              <div class="form-group">
                <label for="berita_summary">Ringkasan (ID)</label>
                <textarea id="berita_summary" name="summary" rows="3" placeholder="Ringkasan singkat berita dalam Bahasa Indonesia..."><%= editData && editType === 'berita' ? editData.summary : '' %></textarea>
              </div>
              
              <div class="form-group">
                <label for="berita_content">Isi Konten (ID) <span style="color: red;">*</span></label>
                <input type="hidden" name="content" id="hidden_content" value="<%= editData && editType === 'berita' ? editData.content : '' %>">
                <div id="editor-container" style="height: 300px;"></div>
              </div>
            </div>
            
            <!-- English Content -->
            <div class="lang-content" id="lang-content-en" style="display: none;">
              <div class="form-group">
                <label for="berita_title_en">News Title (EN)</label>
                <input type="text" id="berita_title_en" name="title_en" value="<%= editData && editType === 'berita' ? (editData.title_en || '') : '' %>" placeholder="Enter news title in English">
              </div>
              
              <div class="form-group">
                <label for="berita_summary_en">Summary (EN)</label>
                <textarea id="berita_summary_en" name="summary_en" rows="3" placeholder="Brief summary in English..."><%= editData && editType === 'berita' ? (editData.summary_en || '') : '' %></textarea>
              </div>
              
              <div class="form-group">
                <label for="berita_content_en">Content (EN)</label>
                <input type="hidden" name="content_en" id="hidden_content_en" value="<%= editData && editType === 'berita' ? (editData.content_en || '') : '' %>">
                <div id="editor-container-en" style="height: 300px;"></div>
              </div>
            </div>
            
            <div class="form-row">
              <div class="form-group" style="flex: 1;">
                <label for="berita_image">Gambar Utama (JPG/PNG, Max 5MB)</label>
                <% if (editData && editType === 'berita' && editData.image) { %>
                  <div style="margin-bottom: 0.5rem;">
                    <img src="<%= editData.image %>" alt="Current Image" style="height: 50px; border-radius: 4px;">
                    <small style="display: block; color: var(--admin-text-light);">Gambar saat ini</small>
                  </div>
                <% } %>
                <input type="file" id="berita_image" name="image" accept=".jpg,.jpeg,.png">
              </div>
              
              <div class="form-group" style="flex: 1;">
                <label for="berita_status">Status</label>
                <select id="berita_status" name="status">
                  <option value="draft" <%= editData && !editData.published ? 'selected' : '' %>>Draft</option>
                  <option value="published" <%= editData && editData.published ? 'selected' : '' %>>Publikasikan</option>
                </select>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan</button>
              <button type="button" class="btn btn-outline" onclick="toggleForm('berita')">Batal</button>
            </div>
          </form>
        </div>

        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Judul</th>
                <th style="width: 100px;">Status</th>
                <th style="width: 120px;">Tanggal</th>
                <th style="width: 120px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (berita.length > 0) { %>
                <% berita.forEach(item => { %>
                  <tr>
                    <td><strong><%= item.title %></strong></td>
                    <td>
                      <% if (item.published) { %>
                        <span class="badge badge-success">Published</span>
                      <% } else { %>
                        <span class="badge badge-warning">Draft</span>
                      <% } %>
                    </td>
                    <td><%= new Date(item.created_at).toLocaleDateString('id-ID') %></td>
                    <td>
                      <a href="/admin?tab=berita&edit=<%= item.id %>&type=berita" class="btn btn-sm btn-outline" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                      <form action="/admin/berita/<%= item.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Hapus berita ini?')">
                        <button type="submit" class="btn btn-sm btn-danger" title="Hapus">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center">
                    <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 0.5rem; display: block; opacity: 0.5;"></i>
                    Belum ada berita
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if (typeof beritaPagination !== 'undefined' && beritaPagination && beritaPagination.totalPages > 1) { %>
          <div class="pagination" style="display: flex; justify-content: center; margin-top: 1.5rem; gap: 0.5rem;">
            <!-- Previous Button -->
            <% if (beritaPagination.page > 1) { %>
              <a href="?tab=berita&berita_page=<%= beritaPagination.page - 1 %>" class="btn btn-outline btn-sm">
                <i class="fas fa-chevron-left"></i>
              </a>
            <% } else { %>
              <button class="btn btn-outline btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                <i class="fas fa-chevron-left"></i>
              </button>
            <% } %>
            
            <!-- Page Numbers -->
            <% for (let i = 1; i <= beritaPagination.totalPages; i++) { %>
              <% 
                // Show pages around current page
                if (i === 1 || i === beritaPagination.totalPages || (i >= beritaPagination.page - 1 && i <= beritaPagination.page + 1)) { 
              %>
                <a href="?tab=berita&berita_page=<%= i %>" class="btn btn-sm <%= i === beritaPagination.page ? 'btn-primary' : 'btn-outline' %>">
                  <%= i %>
                </a>
              <% } else if (i === beritaPagination.page - 2 || i === beritaPagination.page + 2) { %>
                <span style="display: flex; align-items: center; padding: 0 0.5rem;">...</span>
              <% } %>
            <% } %>
            
            <!-- Next Button -->
            <% if (beritaPagination.page < beritaPagination.totalPages) { %>
              <a href="?tab=berita&berita_page=<%= beritaPagination.page + 1 %>" class="btn btn-outline btn-sm">
                <i class="fas fa-chevron-right"></i>
              </a>
            <% } else { %>
              <button class="btn btn-outline btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                <i class="fas fa-chevron-right"></i>
              </button>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- ========== CABANG TAB ========== -->
      <div class="tab-content <%= activeTab === 'cabang' ? 'active' : '' %>" id="tab-cabang">
        <div class="tab-header">
          <div>
            <h2><i class="fas fa-building" style="color: var(--admin-primary); margin-right: 0.5rem;"></i> Info Kantor Cabang</h2>
            <p class="tab-description">Perbarui data alamat, kontak, dan embed Google Maps semua kantor cabang.</p>
          </div>
          <button class="btn btn-primary" onclick="toggleForm('cabang')">
            <i class="fas fa-plus"></i> Tambah Cabang
          </button>
        </div>

        <!-- Form Tambah/Edit Cabang -->
        <div class="form-section <%= (editType === 'cabang') ? 'form-visible' : '' %>" id="form-cabang">
          <form action="<%= editData && editType === 'cabang' ? '/admin/cabang/' + editData.id + '/update' : '/admin/cabang/create' %>" method="POST" class="inline-form">
            <h3><%= editData && editType === 'cabang' ? 'Edit Informasi Cabang' : 'Tambah Cabang Baru' %></h3>
            
            <div class="form-group">
              <label for="cabang_name">Nama Kantor Cabang</label>
              <input type="text" id="cabang_name" name="name" value="<%= editData && editType === 'cabang' ? editData.name : '' %>" required placeholder="Contoh: Kantor Pusat Makassar">
            </div>
            
            <div class="form-group">
              <label for="cabang_address">Alamat Kantor Cabang</label>
              <textarea id="cabang_address" name="address" rows="3" placeholder="Alamat lengkap kantor cabang..."><%= editData && editType === 'cabang' ? editData.address : '' %></textarea>
            </div>
            
            <div class="form-row">
              <div class="form-group" style="flex: 1;">
                <label for="cabang_phone">No. Telepon / HP</label>
                <input type="text" id="cabang_phone" name="phone" value="<%= editData && editType === 'cabang' ? editData.phone : '' %>" placeholder="(0411) xxx-xxxx atau 08xx-xxxx-xxxx">
              </div>
              <div class="form-group" style="flex: 1;">
                <label for="cabang_email">Email</label>
                <input type="email" id="cabang_email" name="email" value="<%= editData && editType === 'cabang' ? editData.email : '' %>" placeholder="cabang@bbi.co.id">
              </div>
            </div>
            
            <div class="form-group">
              <label for="cabang_map">Google Maps Embed (iframe)</label>
              <textarea id="cabang_map" name="map_embed" rows="3" placeholder="Paste kode iframe dari Google Maps di sini..."><%= editData && editType === 'cabang' ? (editData.map_embed || '') : '' %></textarea>
              <small style="color: var(--admin-text-light); font-size: 0.8rem;">
                Cara mendapatkan: Buka Google Maps > Pilih lokasi > Share > Embed a map > Copy HTML
              </small>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan</button>
              <button type="button" class="btn btn-outline" onclick="toggleForm('cabang')">Batal</button>
            </div>
          </form>
        </div>

        <!-- Daftar Cabang dengan Card -->
        <% if (cabang.length > 0) { %>
          <div class="cabang-grid">
            <% cabang.forEach(c => { %>
              <div class="cabang-card">
                <!-- Info Section (Left) -->
                <!-- Info Section (Left) -->
                <div class="cabang-info">
                  <h3 style="display: flex; align-items: flex-start; margin-bottom: 1.5rem; font-size: 1.3rem; font-weight: 700;">
                    <i class="fas fa-building" style="width: 18px; text-align: center; margin-right: 0.75rem; margin-top: 0.25rem; color: var(--primary);"></i>
                    <%= c.name %>
                  </h3>
                  
                  <div class="cabang-info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span><%= c.address || 'Alamat belum diisi' %></span>
                  </div>
                  <div class="cabang-info-item">
                    <i class="fas fa-phone"></i>
                    <span><%= c.phone || 'Telepon belum diisi' %></span>
                  </div>
                  <% if (c.email) { %>
                    <div class="cabang-info-item">
                      <i class="fas fa-envelope"></i>
                      <span><%= c.email %></span>
                    </div>
                  <% } %>

                  <div class="cabang-actions">
                    <a href="/admin?tab=cabang&edit=<%= c.id %>&type=cabang" class="btn btn-sm btn-outline" title="Edit">
                      <i class="fas fa-edit"></i> Edit
                    </a>
                    <form action="/admin/cabang/<%= c.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Hapus cabang ini?')">
                      <button type="submit" class="btn btn-sm btn-danger" title="Hapus">
                        <i class="fas fa-trash"></i> Hapus
                      </button>
                    </form>
                  </div>
                </div>
                
                <!-- Map Section (Right) -->
                <% if (c.map_embed) { %>
                  <div class="cabang-map">
                    <%- c.map_embed %>
                  </div>
                <% } else { %>
                  <div class="cabang-map-placeholder">
                    <i class="fas fa-map"></i>
                    <span>Peta belum ditambahkan</span>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
          
          <!-- Pagination for Cabang -->
          <% if (typeof cabangPagination !== 'undefined' && cabangPagination && cabangPagination.totalPages > 1) { %>
            <div class="pagination" style="display: flex; justify-content: center; margin-top: 1.5rem; gap: 0.5rem;">
              <!-- Previous Button -->
              <% if (cabangPagination.page > 1) { %>
                <a href="?tab=cabang&cabang_page=<%= cabangPagination.page - 1 %>" class="btn btn-outline btn-sm">
                  <i class="fas fa-chevron-left"></i>
                </a>
              <% } else { %>
                <button class="btn btn-outline btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                  <i class="fas fa-chevron-left"></i>
                </button>
              <% } %>
              
              <!-- Page Numbers -->
              <% for (let i = 1; i <= cabangPagination.totalPages; i++) { %>
                <% 
                  // Show pages around current page
                  if (i === 1 || i === cabangPagination.totalPages || (i >= cabangPagination.page - 1 && i <= cabangPagination.page + 1)) { 
                %>
                  <a href="?tab=cabang&cabang_page=<%= i %>" class="btn btn-sm <%= i === cabangPagination.page ? 'btn-primary' : 'btn-outline' %>">
                    <%= i %>
                  </a>
                <% } else if (i === cabangPagination.page - 2 || i === cabangPagination.page + 2) { %>
                  <span style="display: flex; align-items: center; padding: 0 0.5rem;">...</span>
                <% } %>
              <% } %>
              
              <!-- Next Button -->
              <% if (cabangPagination.page < cabangPagination.totalPages) { %>
                <a href="?tab=cabang&cabang_page=<%= cabangPagination.page + 1 %>" class="btn btn-outline btn-sm">
                  <i class="fas fa-chevron-right"></i>
                </a>
              <% } else { %>
                <button class="btn btn-outline btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                  <i class="fas fa-chevron-right"></i>
                </button>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <div class="empty-state">
            <i class="fas fa-building"></i>
            <h3>Belum ada data cabang</h3>
            <p>Klik tombol "Tambah Cabang" untuk menambahkan informasi kantor cabang</p>
          </div>
        <% } %>
      </div>

      <!-- ========== COMMENTS TAB ========== -->
      <div class="tab-content <%= activeTab === 'comments' ? 'active' : '' %>" id="tab-comments">
        <div class="tab-header">
          <h2><i class="fas fa-comments" style="color: var(--admin-primary); margin-right: 0.5rem;"></i> Komentar Berita</h2>
        </div>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Nama</th>
                <th>Berita</th>
                <th>Komentar</th>
                <th>Status</th>
                <th style="width: 120px;">Tanggal</th>
                <th style="width: 140px;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (comments.length > 0) { %>
                <% comments.forEach(c => { %>
                  <tr>
                    <td>
                      <strong><%= c.name %></strong><br>
                      <small class="text-muted"><%= c.email || '-' %></small>
                    </td>
                    <td><%= c.berita_title || '-' %></td>
                    <td><%= (c.content || '').substring(0, 60) %><%= (c.content || '').length > 60 ? '...' : '' %></td>
                    <td>
                      <% if (c.approved) { %>
                        <span class="badge badge-success">Approved</span>
                      <% } else { %>
                        <span class="badge badge-warning">Pending</span>
                      <% } %>
                    </td>
                    <td><%= new Date(c.created_at).toLocaleDateString('id-ID') %></td>
                    <td>
                      <form action="/admin/comments/<%= c.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Hapus komentar ini?')">
                        <button type="submit" class="btn btn-sm btn-danger" title="Hapus">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                      <% if (!c.approved) { %>
                        <form action="/admin/comments/<%= c.id %>/approve" method="POST" style="display:inline; margin-left: 4px;">
                          <button type="submit" class="btn btn-sm btn-success" title="Setujui">
                            <i class="fas fa-check"></i>
                          </button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center">
                    <i class="fas fa-comments" style="font-size: 2rem; margin-bottom: 0.5rem; display: block; opacity: 0.5;"></i>
                    Belum ada komentar
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if (typeof commentPagination !== 'undefined' && commentPagination && commentPagination.totalPages > 1) { %>
          <div class="pagination" style="display: flex; justify-content: center; margin-top: 1.5rem; gap: 0.5rem;">
            <!-- Previous Button -->
            <% if (commentPagination.page > 1) { %>
              <a href="?tab=comments&comment_page=<%= commentPagination.page - 1 %>" class="btn btn-outline btn-sm">
                <i class="fas fa-chevron-left"></i>
              </a>
            <% } else { %>
              <button class="btn btn-outline btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                <i class="fas fa-chevron-left"></i>
              </button>
            <% } %>
            
            <!-- Page Numbers -->
            <% for (let i = 1; i <= commentPagination.totalPages; i++) { %>
              <% 
                // Show pages around current page (1, last, and current +/- 1)
                if (i === 1 || i === commentPagination.totalPages || (i >= commentPagination.page - 1 && i <= commentPagination.page + 1)) { 
              %>
                <a href="?tab=comments&comment_page=<%= i %>" class="btn btn-sm <%= i === commentPagination.page ? 'btn-primary' : 'btn-outline' %>">
                  <%= i %>
                </a>
              <% } else if (i === commentPagination.page - 2 || i === commentPagination.page + 2) { %>
                <span style="display: flex; align-items: center; padding: 0 0.5rem;">...</span>
              <% } %>
            <% } %>
            
            <!-- Next Button -->
            <% if (commentPagination.page < commentPagination.totalPages) { %>
              <a href="?tab=comments&comment_page=<%= commentPagination.page + 1 %>" class="btn btn-outline btn-sm">
                <i class="fas fa-chevron-right"></i>
              </a>
            <% } else { %>
              <button class="btn btn-outline btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                <i class="fas fa-chevron-right"></i>
              </button>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- ========== SETTINGS TAB ========== -->
      <div class="tab-content <%= activeTab === 'settings' ? 'active' : '' %>" id="tab-settings">
        <div class="tab-header">
          <h2><i class="fas fa-cog" style="color: var(--admin-primary); margin-right: 0.5rem;"></i> Pengaturan Website</h2>
        </div>
        <form action="/admin/settings" method="POST" class="form">
          <h3><i class="fas fa-building" style="margin-right: 0.5rem;"></i> Informasi Perusahaan</h3>
          
          <div class="form-group">
            <label for="company_address">Alamat Kantor</label>
            <textarea id="company_address" name="company_address" rows="2" placeholder="Alamat lengkap perusahaan..."><%= settings.company_address || '' %></textarea>
          </div>

          <div class="form-row">
            <div class="form-group" style="flex: 1;">
              <label for="company_email">Email</label>
              <input type="email" id="company_email" name="company_email" value="<%= settings.company_email || '' %>" placeholder="info@company.com">
            </div>
            <div class="form-group" style="flex: 1;">
              <label for="company_whatsapp">WhatsApp (format: 628xxx)</label>
              <input type="text" id="company_whatsapp" name="company_whatsapp" value="<%= settings.company_whatsapp || '' %>" placeholder="6281234567890">
            </div>
          </div>

          <div class="form-group">
            <label for="company_website">Website URL</label>
            <input type="url" id="company_website" name="company_website" value="<%= settings.company_website || '' %>" placeholder="https://example.com">
          </div>
          
          <h3><i class="fas fa-map-marker-alt" style="margin-right: 0.5rem;"></i> Lokasi Kantor Pusat</h3>
          
          <div class="form-group">
            <label for="company_maps">Google Maps Embed (iframe)</label>
            <textarea id="company_maps" name="company_maps" rows="3" placeholder="Paste kode iframe dari Google Maps di sini..."><%= settings.company_maps || '' %></textarea>
            <small style="color: var(--admin-text-light); font-size: 0.8rem;">
              Cara mendapatkan: Buka Google Maps > Pilih lokasi > Share > Embed a map > Copy HTML
            </small>
          </div>
          
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save"></i> Simpan Pengaturan
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</main>

<!-- Quill CSS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">


<!-- Quill JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<style>
  /* Quill Editor Customization */
  .ql-editor {
    min-height: 200px;
    background: var(--admin-card);
    color: var(--admin-text);
  }
  .ql-toolbar.ql-snow {
    border-color: var(--admin-border);
    background: var(--admin-bg);
  }
  .ql-container.ql-snow {
    border-color: var(--admin-border);
    border-bottom-left-radius: var(--admin-radius);
    border-bottom-right-radius: var(--admin-radius);
  }
  .ql-toolbar.ql-snow {
    border-top-left-radius: var(--admin-radius);
    border-top-right-radius: var(--admin-radius);
  }
  
  /* Dark Mode Overrides for Quill */
  body.dark .ql-snow .ql-stroke {
    stroke: var(--admin-text);
  }
  body.dark .ql-snow .ql-fill {
    fill: var(--admin-text);
  }
  body.dark .ql-picker {
    color: var(--admin-text);
  }
  body.dark .ql-picker-options {
    background-color: var(--admin-card);
  }
  
  /* Language Tab Styling */
  .lang-tab {
    padding: 0.5rem 1rem;
    border: 1px solid var(--admin-border);
    background: var(--admin-bg);
    color: var(--admin-text);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.9rem;
  }
  .lang-tab:hover {
    background: var(--admin-primary);
    color: white;
    border-color: var(--admin-primary);
  }
  .lang-tab.active {
    background: var(--admin-primary);
    color: white;
    border-color: var(--admin-primary);
  }
  .lang-content {
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  let quill;
  let quillEn;

  document.addEventListener('DOMContentLoaded', function() {
    // Quill toolbar config
    const toolbarOptions = [
      [{ 'header': [1, 2, 3, false] }],
      ['bold', 'italic', 'underline', 'strike'],
      [{ 'color': [] }, { 'background': [] }],
      [{ 'list': 'ordered'}, { 'list': 'bullet' }],
      [{ 'align': [] }],
      ['link', 'image', 'clean']
    ];
    
    // Initialize Quill editor (Indonesian)
    quill = new Quill('#editor-container', {
      theme: 'snow',
      modules: { toolbar: toolbarOptions }
    });

    // Initialize Quill editor (English)
    quillEn = new Quill('#editor-container-en', {
      theme: 'snow',
      modules: { toolbar: toolbarOptions }
    });

    // Populate editor if editing (Indonesian)
    var existingContent = document.getElementById('hidden_content').value;
    if (existingContent) {
      quill.clipboard.dangerouslyPasteHTML(existingContent);
    }
    
    // Populate editor if editing (English)
    var existingContentEn = document.getElementById('hidden_content_en').value;
    if (existingContentEn) {
      quillEn.clipboard.dangerouslyPasteHTML(existingContentEn);
    }
  });

  // Language tab switching for berita form
  function switchLangTab(lang) {
    // Update tab buttons
    document.querySelectorAll('.lang-tab').forEach(t => t.classList.remove('active'));
    document.querySelector('.lang-tab[data-lang="' + lang + '"]').classList.add('active');
    
    // Update content visibility
    document.getElementById('lang-content-id').style.display = lang === 'id' ? 'block' : 'none';
    document.getElementById('lang-content-en').style.display = lang === 'en' ? 'block' : 'none';
  }

  // Toggle form visibility
  function toggleForm(type) {
    const form = document.getElementById('form-' + type);
    if (form.classList.contains('form-visible')) {
      form.classList.remove('form-visible');
      history.pushState({}, '', '/admin?tab=' + type);
    } else {
      form.classList.add('form-visible');
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Update hidden inputs before submit
  document.querySelector('#form-berita form').onsubmit = function() {
    // Indonesian content
    var content = document.querySelector('input[name=content]');
    content.value = quill.root.innerHTML;
    
    // English content
    var contentEn = document.querySelector('input[name=content_en]');
    contentEn.value = quillEn.root.innerHTML;
  };

  // Tab switching
  document.querySelectorAll('.admin-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const tabId = tab.dataset.tab;
      
      document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.getElementById('tab-' + tabId).classList.add('active');
      
      // Hide all forms when switching tabs
      document.querySelectorAll('.form-section').forEach(f => f.classList.remove('form-visible'));
      
      history.pushState({}, '', '/admin?tab=' + tabId);
    });
  });

  // Auto-show form if editing
  var editType = '<%= editType || "" %>';
  if (editType && document.getElementById('form-' + editType)) {
    document.getElementById('form-' + editType).classList.add('form-visible');
  }
</script>

<%- include('../partials/footer') %>
<%- include('partials/admin-foot') %>
