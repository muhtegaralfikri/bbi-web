<%- include('../partials/admin-head', { pageTitle: 'Manajemen Berita' }) %>
<%- include('../../partials/header') %>
<%- include('../partials/admin-nav', { active: 'berita' }) %>

<main class="admin-layout">
  <div class="container">
    <header class="admin-header">
      <h1>Manajemen Berita</h1>
      <a href="/admin/berita/create" class="btn btn-primary"><i class="fas fa-plus"></i> Tambah Berita</a>
    </header>

    <div class="admin-body">
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Gambar</th>
              <th>Judul</th>
              <th>Kategori</th>
              <th>Status</th>
              <th>Tanggal</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% berita.forEach(item => { %>
              <tr>
                <td>
                  <img src="<%= item.image || '/images/news/default.jpg' %>" alt="<%= item.title %>" class="table-image">
                </td>
                <td><%= item.title %></td>
                <td><span class="badge badge-warning"><%= item.category %></span></td>
                <td>
                  <% if (item.published) { %>
                    <span class="badge badge-success">Published</span>
                  <% } else { %>
                    <span class="badge badge-warning">Draft</span>
                  <% } %>
                </td>
                <td><%= new Date(item.created_at).toLocaleDateString('id-ID') %></td>
                <td>
                  <a href="/admin/berita/<%= item.id %>/edit" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                  <form action="/admin/berita/<%= item.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Hapus berita ini?')">
                    <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
<%- include('../partials/admin-foot') %>
