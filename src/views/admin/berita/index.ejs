<% layout = false %>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Berita - Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('partials/admin-sidebar', { active: 'berita' }) %>

    <main class="admin-content">
      <header class="admin-header">
        <h1>Kelola Berita</h1>
        <a href="/admin/berita/create" class="btn btn-primary"><i class="fas fa-plus"></i> Tambah Berita</a>
      </header>

      <div class="admin-body">
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Gambar</th>
                <th>Judul</th>
                <th>Kategori</th>
                <th>Status</th>
                <th>Tanggal</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% berita.forEach(b => { %>
                <tr>
                  <td>
                    <% if (b.image) { %>
                      <img src="<%= b.image %>" alt="" class="table-image">
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td><%= b.title %></td>
                  <td><span class="badge"><%= b.category || 'Umum' %></span></td>
                  <td>
                    <% if (b.published) { %>
                      <span class="badge badge-success">Published</span>
                    <% } else { %>
                      <span class="badge badge-warning">Draft</span>
                    <% } %>
                  </td>
                  <td><%= new Date(b.created_at).toLocaleDateString('id-ID') %></td>
                  <td>
                    <a href="/admin/berita/<%= b.id %>/edit" class="btn btn-sm"><i class="fas fa-edit"></i></a>
                    <form action="/admin/berita/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Hapus berita ini?')" style="display:inline">
                      <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
