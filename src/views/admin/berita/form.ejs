<%- include('../partials/admin-head', { pageTitle: berita ? 'Edit Berita' : 'Tambah Berita' }) %>
<%- include('../../partials/header') %>
<%- include('../partials/admin-nav', { active: 'berita' }) %>

<main class="admin-layout">
  <div class="container">
    <header class="admin-header">
      <h1><%= berita ? 'Edit Berita' : 'Tambah Berita' %></h1>
      <a href="/admin/berita" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Kembali</a>
    </header>

    <div class="admin-body">
      <form action="/admin/berita<%= berita ? '/' + berita.id : '' %>" method="POST" enctype="multipart/form-data" class="form">
        <div class="form-group">
          <label for="title">Judul Berita</label>
          <input type="text" id="title" name="title" value="<%= berita ? berita.title : '' %>" required>
        </div>

        <div class="form-group">
          <label for="category">Kategori</label>
          <select id="category" name="category">
            <option value="umum" <%= (berita && berita.category === 'umum') ? 'selected' : '' %>>Umum</option>
            <option value="bisnis" <%= (berita && berita.category === 'bisnis') ? 'selected' : '' %>>Bisnis</option>
            <option value="press-release" <%= (berita && berita.category === 'press-release') ? 'selected' : '' %>>Press Release</option>
          </select>
        </div>

        <div class="form-group">
          <label for="content">Konten</label>
          <textarea id="content" name="content" rows="10" required><%= berita ? berita.content : '' %></textarea>
        </div>

        <div class="form-group">
          <label for="image">Gambar Utama</label>
          <% if (berita && berita.image) { %>
            <div style="margin-bottom: 10px;">
              <img src="<%= berita.image %>" alt="Current Image" class="preview-image" style="max-height: 200px;">
            </div>
          <% } %>
          <input type="file" id="image" name="image" accept="image/*">
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="published" <%= (berita && berita.published) ? 'checked' : '' %>> Publish sekarang
          </label>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan Berita</button>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
<%- include('../partials/admin-foot') %>
