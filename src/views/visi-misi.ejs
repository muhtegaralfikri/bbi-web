<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof t !== 'undefined' ? t.visionMission.title : 'Visi & Misi' %> - Bosowa Bandar Group</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <h1><%= typeof t !== 'undefined' ? t.visionMission.title : 'Visi & Misi' %></h1>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <!-- Intro Section -->
        <div class="row mb-5">
          <div class="col-12 text-center">
            <p class="lead text-muted" style="max-width: 800px; margin: 0 auto;">
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'As part of Bosowa Group, Bosowa Bandar Group is committed to becoming a modern, efficient, and highly competitive port and logistics management company. Our vision and mission form the foundation for every step of business development to support national economic development.' : 'Sebagai bagian dari Bosowa Group, Bosowa Bandar Group berkomitmen untuk menjadi perusahaan pengelola pelabuhan dan logistik yang modern, efisien, dan berdaya saing tinggi. Visi dan misi kami menjadi dasar dalam setiap langkah pengembangan bisnis untuk mendukung pembangunan ekonomi nasional.' %>
            </p>
          </div>
        </div>

        <!-- Visi & Misi Grid -->
        <div class="grid grid-2 gap-4 mb-5">
          <div class="card vision-card">
            <div class="card-icon"><i class="fas fa-eye"></i></div>
            <h3><%= typeof t !== 'undefined' ? t.visionMission.vision : 'Visi' %></h3>
            <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'To become a professional port management company with international standards.' : 'Menjadi perusahaan pengelola pelabuhan yang profesional dan berstandar internasional.' %></p>
          </div>
          <div class="card mission-card">
            <div class="card-icon"><i class="fas fa-rocket"></i></div>
            <h3><%= typeof t !== 'undefined' ? t.visionMission.mission : 'Misi' %></h3>
            <ul class="mission-list">
              <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Work with the concept of excellent service.' : 'Bekerja dengan konsep pelayanan prima.' %></li>
              <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Run operations professionally and efficiently.' : 'Menjalankan operasional secara profesional dan efisien.' %></li>
              <li><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Maximize benefits for all stakeholders.' : 'Memaksimalkan manfaat bagi seluruh pemangku kepentingan.' %></li>
            </ul>
          </div>
        </div>

        <!-- Nilai Perusahaan (PRIMA) -->
        <div class="company-values mt-5">
          <div class="section-header text-center mb-5">
            <h2 class="section-title"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'PRIMA Philosophy' : 'Filosofi' %> <span class="text-prima">PRIMA</span></h2>
            <p class="section-desc"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'We uphold PRIMA values in every aspect of work' : 'Kami menjunjung tinggi nilai-nilai' %> <span class="text-prima">PRIMA</span> <%= typeof t !== 'undefined' && t.lang === 'en' ? '' : 'dalam setiap aspek pekerjaan' %></p>
          </div>
          
          <div class="values-grid">
            <div class="value-card">
              <div class="value-letter">P</div>
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Professional' : 'Profesional' %></h3>
              <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Carrying out tasks with high competence, integrity, and responsibility to maintain Bosowa\'s reputation as a trusted partner in the maritime industry.' : 'Menjalankan tugas dengan kompetensi tinggi, integritas, dan tanggung jawab demi menjaga reputasi Bosowa sebagai mitra terpercaya di industri maritim.' %></p>
            </div>
            <div class="value-card">
              <div class="value-letter">R</div>
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Responsive' : 'Responsif' %></h3>
              <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Quick and responsive in meeting customer needs and changes in the port environment and maritime industry.' : 'Cepat dan tanggap dalam memenuhi kebutuhan pelanggan serta perubahan situasi di lingkungan pelabuhan dan industri maritim.' %></p>
            </div>
            <div class="value-card">
              <div class="value-letter">I</div>
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Innovative' : 'Inovatif' %></h3>
              <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Continuously adapting and developing new solutions to improve efficiency, services, and company competitiveness.' : 'Terus beradaptasi dan mengembangkan solusi baru guna meningkatkan efisiensi, layanan, dan daya saing perusahaan.' %></p>
            </div>
            <div class="value-card">
              <div class="value-letter">M</div>
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Serving' : 'Melayani' %></h3>
              <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Prioritizing customer satisfaction by providing friendly, fast, and targeted service.' : 'Mengutamakan kepuasan pelanggan dengan memberikan pelayanan yang ramah, cepat, dan tepat sasaran.' %></p>
            </div>
            <div class="value-card">
              <div class="value-letter">A</div>
              <h3><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Trustworthy & Reliable' : 'Amanah & Terpercaya' %></h3>
              <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Maintaining the trust of partners and stakeholders by working honestly, consistently, and upholding moral values and social responsibility.' : 'Menjaga kepercayaan mitra dan stakeholder dengan bekerja jujur, konsisten, serta menjunjung nilai-nilai moral dan tanggung jawab sosial.' %></p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
