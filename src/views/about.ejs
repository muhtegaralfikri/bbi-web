<% layout = false %>
<!DOCTYPE html>
<html lang="<%= typeof t !== 'undefined' ? t.lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof t !== 'undefined' ? t.about.title : 'Tentang Kami' %> - Bosowa Bandar Group</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css?v=2.4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>


    <!-- History / Intro Section -->
    <section class="section">
      <div class="container">
        <div class="about-intro">
          <div class="about-image">
            <img src="/images/about/bosowa-group.webp" alt="Bosowa Group" class="img-fluid rounded-lg shadow-lg show-light">
            <img src="/images/about/bosowa-group-white.webp" alt="Bosowa Group" class="img-fluid rounded-lg shadow-lg show-dark">
          </div>
          <div class="about-text">
            <h2><%= typeof t !== 'undefined' && t.lang === 'en' ? 'About Bosowa Group' : 'Tentang Grup Bosowa' %></h2>
            <p>
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Founded in 1973 by Dr. H. Aksa Mahmud, Bosowa Group (PT Bosowa Corporindo) is one of the largest conglomerates in Eastern Indonesia. Starting from cement trading, Bosowa has grown into a multinational business group with more than 30 subsidiaries operating in various strategic sectors, including automotive, cement, finance, infrastructure, energy, and education.' : 'Didirikan pada tahun 1973 oleh Dr. H. Aksa Mahmud, Grup Bosowa (PT Bosowa Corporindo) merupakan salah satu konglomerasi terbesar di Indonesia Timur. Berawal dari perdagangan semen, Bosowa telah berkembang menjadi grup usaha multinasional dengan lebih dari 30 anak perusahaan yang bergerak di berbagai sektor strategis, termasuk otomotif, semen, keuangan, infrastruktur, energi, dan pendidikan.' %>
            </p>
            <p>
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'As a pioneer of development in Eastern Indonesia, Bosowa has a strong commitment to national economic independence. With the spirit of "Building from the East for Indonesia", Bosowa continues to innovate in providing solutions and services that add value to society and support national economic growth.' : 'Sebagai pionir pembangunan di Kawasan Timur Indonesia, Bosowa memiliki komitmen kuat terhadap kemandirian ekonomi bangsa. Dengan semangat "Membangun dari Timur untuk Indonesia", Bosowa terus berinovasi menghadirkan solusi dan layanan yang memberi nilai tambah bagi masyarakat serta mendukung pertumbuhan ekonomi nasional.' %>
            </p>
            <p>
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Under the umbrella of PT Bosowa Corporindo, all business units are managed with principles of professionalism, sustainability, and social responsibility.' : 'Di bawah payung PT Bosowa Corporindo, seluruh unit bisnis dikelola dengan prinsip profesionalisme, keberlanjutan, dan tanggung jawab sosial.' %>
            </p>

            <h2 class="mt-4">Bosowa Bandar Group</h2>
            <p>
              <%= typeof t !== 'undefined' && t.lang === 'en' ? 'Bosowa Bandar Group is one of the strategic business units under Bosowa Group that focuses on port management, cargo handling, and integrated logistics. Established to support national distribution and trade activities, Bosowa Bandar Group becomes an important link between industry, trade, and sea transportation sectors.' : 'Bosowa Bandar Group adalah salah satu unit bisnis strategis di bawah Bosowa Group yang berfokus pada pengelolaan pelabuhan, jasa bongkar muat, dan logistik terpadu. Didirikan untuk mendukung kegiatan distribusi dan perdagangan nasional, Bosowa Bandar Group menjadi penghubung penting antara sektor industri, perdagangan, dan transportasi laut.' %>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Subsidiaries Section -->
    <section class="section bg-light">
      <div class="container">
        <div class="section-header text-center mb-5">
          <h2 class="section-title"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Business Units under Bosowa Bandar Group' : 'Unit Bisnis di Bawah Bosowa Bandar Group' %></h2>
          <p class="section-desc"><%= typeof t !== 'undefined' && t.lang === 'en' ? 'As part of the ever-growing Bosowa Group, Bosowa Bandar Group oversees several supporting business units that play a role in strengthening the national port and logistics ecosystem.' : 'Sebagai bagian dari Grup Bosowa yang terus berkembang, Bosowa Bandar Group menaungi beberapa unit usaha pendukung yang berperan dalam memperkuat ekosistem pelabuhan dan logistik nasional.' %></p>
        </div>
        <div class="subsidiaries-grid">
          <!-- Item 1 -->
          <div class="subsidiary-card">
            <div class="subsidiary-logo">
              <img src="/images/logo/logo-dark.webp" alt="PT Bosowa Bandar Indonesia" class="show-light">
              <img src="/images/logo/logo-signin.webp" alt="PT Bosowa Bandar Indonesia" class="show-dark">
            </div>
            <h3>PT Bosowa Bandar Indonesia</h3>
            <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'The main entity that manages ports, cargo handling, and integrated logistics services with professional standards and efficiency orientation.' : 'Entitas utama yang mengelola pelabuhan, bongkar muat, dan layanan logistik terpadu dengan standar profesional dan berorientasi pada efisiensi.' %></p>
          </div>
          <!-- Item 2 -->
          <div class="subsidiary-card">
            <div class="subsidiary-logo">
              <img src="/images/about/bosowa-agensi.webp" alt="PT Bosowa Bandar Agensi" class="show-light">
              <img src="/images/about/bosowa-agensi-white.webp" alt="PT Bosowa Bandar Agensi" class="show-dark">
            </div>
            <h3>PT Bosowa Bandar Agensi</h3>
            <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Engaged in ship agency, providing professional services to ensure smooth shipping activities at Bosowa ports and surrounding areas.' : 'Bergerak di bidang keagenan kapal, menyediakan layanan profesional untuk memastikan kelancaran aktivitas pelayaran di pelabuhan Bosowa dan kawasan sekitarnya.' %></p>
          </div>
          <!-- Item 3 -->
          <div class="subsidiary-card">
            <div class="subsidiary-logo">
              <img src="/images/about/jasa-pelabuhan.webp" alt="PT Jasa Pelabuhan Indonesia" class="show-light">
              <img src="/images/about/jasa-pelabuhan-white.webp" alt="PT Jasa Pelabuhan Indonesia" class="show-dark">
            </div>
            <h3>PT Jasa Pelabuhan Indonesia</h3>
            <p><%= typeof t !== 'undefined' && t.lang === 'en' ? 'Focuses on port operational management and provision of supporting technical services such as cargo handling, terminal, and integrated maritime operations.' : 'Befokus pada pengelolaan operasional pelabuhan serta penyediaan layanan teknis pendukung seperti bongkar muat, terminal, dan operasional maritim terpadu.' %></p>
          </div>
        </div>
      </div>
    </section>


  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
