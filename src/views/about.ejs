<% layout = false %>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tentang Kami - Bosowa Bandar Group</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <h1>Tentang Kami</h1>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="content">
          <h2>Visi & Misi</h2>
          <div class="grid grid-2">
            <div class="card">
              <h3>Visi</h3>
              <p>Menjadi perusahaan terkemuka yang dapat memberikan kontribusi positif bagi masyarakat dan bangsa.</p>
            </div>
            <div class="card">
              <h3>Misi</h3>
              <ul>
                <li>Menyediakan produk dan jasa berkualitas tinggi</li>
                <li>Mengembangkan sumber daya manusia yang kompeten</li>
                <li>Memberikan kepuasan kepada pelanggan</li>
                <li>Berkontribusi bagi pembangunan nasional</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
